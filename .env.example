# Copy this file to `.env` and edit. Docker Compose reads `.env`
# automatically and substitutes ${VAR} references in docker-compose.yml.
#
#   cp .env.example .env
#   # then `vi .env` and fill in your provider key

# ----------------------------------------------------------------
# LLM provider key (REQUIRED)
# ----------------------------------------------------------------
# Get one at https://openrouter.ai/ (one key, many models).
# OPENROUTER_API_KEY=sk-or-v1-...

# Or, if you'd rather use OpenAI directly:
# OPENAI_API_KEY=sk-proj-...

# Or, a local LLM endpoint (vLLM / Ollama / llamacpp serving an
# OpenAI-compatible /v1/* API):
# LOCAL_LLM_BASE_URL=http://localhost:8001/v1

# ----------------------------------------------------------------
# Model selection (OPTIONAL — defaults shown)
# ----------------------------------------------------------------
# Default is deepseek/deepseek-v4-flash. Cheap, fast, surprisingly
# capable on ML tasks. Override here if you want to try a stronger
# (and pricier) model.
# MLE_BEAST_MODEL=deepseek/deepseek-v4-flash
# MLE_BEAST_MODEL=anthropic/claude-haiku-4-5
# MLE_BEAST_MODEL=openai/gpt-4o-mini

# Pin the provider when you have multiple keys above and want to be
# explicit. Defaults to the resolution order:
#   LOCAL_LLM_BASE_URL > OPENROUTER_API_KEY > OPENAI_API_KEY
# MLE_BEAST_PROVIDER=openrouter
